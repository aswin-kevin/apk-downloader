{
  "name": "apk-downloader",
  "version": "2.0.0",
  "description": "Download Android apps (APK and XAPK) anonymously from public mirrors, with pluggable sources and automatic fallback. Library and CLI.",
  "keywords": [
    "apk",
    "xapk",
    "apk-downloader",
    "android",
    "playstore",
    "apkpure",
    "aptoide",
    "cli"
  ],
  "author": "Aswin Venkat",
  "license": "MIT",
  "homepage": "https://github.com/aswin-kevin/apk-downloader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aswin-kevin/apk-downloader.git"
  },
  "bugs": {
    "url": "https://github.com/aswin-kevin/apk-downloader/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "apk-downloader": "./bin/apk-downloader.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run test/unit",
    "test:live": "APKDL_LIVE=1 vitest run test/live",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/yauzl": "^3.4.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "undici": "^7.30.2",
    "yauzl": "^3.4.0"
  }
}
