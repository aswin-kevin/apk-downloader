# Supply-chain hardening:
# - never run dependency lifecycle scripts (install/postinstall) during development
# - record exact versions so nothing floats to a freshly published release
#
# Note: ignore-scripts also disables this package's own lifecycle hooks (prepublishOnly,
# prepack, ...). Publish with `npm run release`, which verifies, builds and checks the tarball.
ignore-scripts=true
save-exact=true
